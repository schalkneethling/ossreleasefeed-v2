{
  "name": "ossreleasefeed-v2",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:worker": "varlock run -- pnpm --filter worker dev",
    "build:frontend": "pnpm --filter frontend build",
    "build:worker": "pnpm --filter worker build",
    "build": "pnpm run build:frontend && pnpm run build:worker",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "lint": "oxlint . && stylelint \"frontend/src/**/*.css\" && pnpm run format:check",
    "lint:actions": "actionlint && zizmor .github/workflows/",
    "check:dependency-invariants": "node scripts/check-dependency-invariants.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@varlock/1password-plugin": "^2.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "effect": "^3.22.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.73.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-logical-css": "^2.1.0",
    "stylelint-plugin-use-baseline": "*",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "typescript": "^7.0.2",
    "varlock": "^1.17.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
